{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/empresa",
      "destination": "/sobre",
      "permanent": true
    },
    {
      "source": "/ambientes/móveis especiais",
      "destination": "/ambientes/moveis-especiais",
      "permanent": true
    },
    {
      "source": "/ambientes/m%C3%B3veis%20especiais",
      "destination": "/ambientes/moveis-especiais",
      "permanent": true
    },
    {
      "source": "/ambientes/móveis especiais/aparador-moderno",
      "destination": "/ambientes/moveis-especiais/aparador-moderno",
      "permanent": true
    },
    {
      "source": "/ambientes/m%C3%B3veis%20especiais/aparador-moderno",
      "destination": "/ambientes/moveis-especiais/aparador-moderno",
      "permanent": true
    },
    {
      "source": "/ambientes/móveis especiais/divisória de ambientes",
      "destination": "/ambientes/moveis-especiais/divisoria-de-ambientes",
      "permanent": true
    },
    {
      "source": "/ambientes/m%C3%B3veis%20especiais/divis%C3%B3ria%20de%20ambientes",
      "destination": "/ambientes/moveis-especiais/divisoria-de-ambientes",
      "permanent": true
    },
    {
      "source": "/ambientes/móveis especiais/mesa extensível",
      "destination": "/ambientes/moveis-especiais/mesa-extensivel",
      "permanent": true
    },
    {
      "source": "/ambientes/m%C3%B3veis%20especiais/mesa%20extens%C3%ADvel",
      "destination": "/ambientes/moveis-especiais/mesa-extensivel",
      "permanent": true
    },
    {
      "source": "/ambientes/móveis especiais/mesa-e-banco",
      "destination": "/ambientes/moveis-especiais/mesa-e-banco",
      "permanent": true
    },
    {
      "source": "/ambientes/m%C3%B3veis%20especiais/mesa-e-banco",
      "destination": "/ambientes/moveis-especiais/mesa-e-banco",
      "permanent": true
    },
    {
      "source": "/ambientes/móveis especiais/mesas-em-madeira",
      "destination": "/ambientes/moveis-especiais/mesas-em-madeira",
      "permanent": true
    },
    {
      "source": "/ambientes/m%C3%B3veis%20especiais/mesas-em-madeira",
      "destination": "/ambientes/moveis-especiais/mesas-em-madeira",
      "permanent": true
    },
    {
      "source": "/ambientes/sala de estar",
      "destination": "/ambientes/sala-de-estar",
      "permanent": true
    },
    {
      "source": "/ambientes/sala%20de%20estar",
      "destination": "/ambientes/sala-de-estar",
      "permanent": true
    },
    {
      "source": "/ambientes/sala de estar/aparador para sala",
      "destination": "/ambientes/sala-de-estar/aparador-para-sala",
      "permanent": true
    },
    {
      "source": "/ambientes/sala%20de%20estar/aparador%20para%20sala",
      "destination": "/ambientes/sala-de-estar/aparador-para-sala",
      "permanent": true
    },
    {
      "source": "/ambientes/sala de estar/cristaleira especial",
      "destination": "/ambientes/sala-de-estar/cristaleira-especial",
      "permanent": true
    },
    {
      "source": "/ambientes/sala%20de%20estar/cristaleira%20especial",
      "destination": "/ambientes/sala-de-estar/cristaleira-especial",
      "permanent": true
    },
    {
      "source": "/ambientes/sala de estar/mesa de centro",
      "destination": "/ambientes/sala-de-estar/mesa-de-centro",
      "permanent": true
    },
    {
      "source": "/ambientes/sala%20de%20estar/mesa%20de%20centro",
      "destination": "/ambientes/sala-de-estar/mesa-de-centro",
      "permanent": true
    },
    {
      "source": "/ambientes/sala de estar/painel para tv",
      "destination": "/ambientes/sala-de-estar/painel-para-tv",
      "permanent": true
    },
    {
      "source": "/ambientes/sala%20de%20estar/painel%20para%20tv",
      "destination": "/ambientes/sala-de-estar/painel-para-tv",
      "permanent": true
    },
    {
      "source": "/ambientes/sala de estar/sala com escritório",
      "destination": "/ambientes/sala-de-estar/sala-com-escritorio",
      "permanent": true
    },
    {
      "source": "/ambientes/sala%20de%20estar/sala%20com%20escrit%C3%B3rio",
      "destination": "/ambientes/sala-de-estar/sala-com-escritorio",
      "permanent": true
    },
    {
      "source": "/ambientes/dormitorio/quarto-lamina-de-madeira-natural",
      "destination": "/ambientes/dormitorio",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://cloud.umami.is; connect-src 'self' https://cloud.umami.is https://api-gateway.umami.dev https://*.supabase.co https://*.unicorn.studio https://storage.googleapis.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(fotos|projetos|destaques)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
